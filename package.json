{
  "name": "minecraft-beta-1.7.3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "validate:all": "tsc -p tsconfig.validation.json && node scripts/fixValidationImports.mjs && node .validation/scripts/validateCore.js && node .validation/scripts/validateWorld.js && node .validation/scripts/validateRendering.js && node .validation/scripts/validatePhysics.js && node .validation/scripts/validateGameplay.js && node .validation/scripts/validateEntities.js && node .validation/scripts/validateSystems.js",
    "validate:core": "tsc -p tsconfig.validation.json && node scripts/fixValidationImports.mjs && node .validation/scripts/validateCore.js",
    "validate:world": "tsc -p tsconfig.validation.json && node scripts/fixValidationImports.mjs && node .validation/scripts/validateWorld.js",
    "validate:rendering": "tsc -p tsconfig.validation.json && node scripts/fixValidationImports.mjs && node .validation/scripts/validateRendering.js",
    "validate:physics": "tsc -p tsconfig.validation.json && node scripts/fixValidationImports.mjs && node .validation/scripts/validatePhysics.js",
    "validate:gameplay": "tsc -p tsconfig.validation.json && node scripts/fixValidationImports.mjs && node .validation/scripts/validateGameplay.js",
    "validate:entities": "tsc -p tsconfig.validation.json && node scripts/fixValidationImports.mjs && node .validation/scripts/validateEntities.js",
    "validate:systems": "tsc -p tsconfig.validation.json && node scripts/fixValidationImports.mjs && node .validation/scripts/validateSystems.js"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "fake-indexeddb": "6.2.5",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
